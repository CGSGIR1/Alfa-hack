# Скопируйте в .env и заполните. Файл .env в git не попадает.
LLM_BASE_URL=https://адрес-api-от-организаторов/v1
LLM_API_KEY=
# Точные имена моделей — как их называет API организаторов
LLM_MODEL_MAIN=
LLM_MODEL_FAST=
# Модель для запросов влияния; если пусто — берётся LLM_MODEL_MAIN
LLM_MODEL_QUERIES=
