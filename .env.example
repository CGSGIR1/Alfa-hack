# Скопируйте в .env и заполните. Файл .env в git не попадает.
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
# Точные имена моделей — как их называет API организаторов
LLM_MODEL_MAIN=deepseek/deepseek-v4.1-flash
LLM_MODEL_FAST=qwen/qwen3.6-35b-a3b
# Модель для запросов влияния; если пусто — берётся LLM_MODEL_MAIN
LLM_MODEL_QUERIES=
# CSV компаний, платежей и связей для кнопки «Добавить компанию»
DATA_DIR=./private-data/csv
# Два мнения в новой схеме отчёта; critic по умолчанию использует SECOND.
LLM_MODEL_SECOND=z-ai/glm-5.3-flash
LLM_MODEL_CRITIC=

# Alternative gateway supplied by the organizers:
# LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
EMBEDDING_MODEL_PATH=./models/embeddinggemma-300m
MODEL_HOST_PATH=./models/embeddinggemma-300m
APP_PORT=8765
# 1: automatic collection (60 seconds by config) and sequential reports; 0: manual.
PIPELINE_AUTO_POLL=1

# Публичная сборка без материалов организаторов; данные подключаются из private-data/
APP_IMAGE=ghcr.io/rastok314/alfa-hack-public:1.1.2
